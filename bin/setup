#!/usr/bin/env ruby
# First-run development setup, idempotent:
#   bin/setup           PostgreSQL (local server or Docker; SQLite fallback), deps, database, seed data
#   bin/setup --reset   Drop and rebuild the development database
# Then `bin/dev` for daily use — Rails + jobs + Vite; open http://localhost:5173
require "fileutils"
require "uri"

APP_ROOT = File.expand_path("..", __dir__)
ENV_FILE = File.join(APP_ROOT, ".env")
DOCKER_DB_URL = "postgres://flow:flow@127.0.0.1:5436/flow_development?gssencmode=disable"

def system!(*args)
  system(*args, exception: true)
end

def psql_ok?(url)
  system("psql", url, "-Atc", "SELECT 1", out: File::NULL, err: File::NULL)
end

def with_db(url, name)
  uri = URI.parse(url)
  uri.path = "/#{name}"
  uri.to_s
end

# Dev prefers the same database engine as production. Best-effort, in order:
# a reachable local server, the Compose dev-profile container (started on
# demand when Docker is around), then the SQLite fallback.
def discover_postgres_url
  return nil unless system("command -v psql >/dev/null 2>&1")
  unless system("pg_isready -q 2>/dev/null")
    if RUBY_PLATFORM.include?("darwin")
      system("brew services start postgresql@16 >/dev/null 2>&1 || brew services start postgresql >/dev/null 2>&1")
    else
      system("service postgresql start >/dev/null 2>&1 || sudo -n service postgresql start >/dev/null 2>&1")
    end
    sleep 1
  end
  candidates = [
    "postgres:///postgres",                                 # unix socket, current user (Homebrew)
    "postgres://postgres@127.0.0.1:5432/postgres",          # trust auth
    "postgres://postgres:postgres@127.0.0.1:5432/postgres",
    "postgres://postgres:ci@127.0.0.1:5432/postgres",       # CI-style server
    DOCKER_DB_URL                                           # Compose dev-profile container
  ]
  admin = candidates.find { |url| psql_ok?(url) }
  if admin.nil? && system("command -v docker >/dev/null 2>&1")
    puts "== Starting the Compose dev-profile PostgreSQL container =="
    if system({ "SECRET_KEY_BASE" => ENV.fetch("SECRET_KEY_BASE", "development") },
              "docker", "compose", "--profile", "dev", "up", "-d", "--wait", "db")
      admin = DOCKER_DB_URL if psql_ok?(DOCKER_DB_URL)
    end
  end
  return nil unless admin

  %w[flow_development flow_test].each do |name|
    exists = `psql "#{admin}" -Atc "SELECT 1 FROM pg_database WHERE datname='#{name}'"`.strip == "1"
    system!("psql", admin, "-qc", "CREATE DATABASE #{name}") unless exists
  end
  with_db(admin, "flow_development")
end

FileUtils.chdir APP_ROOT do
  # .env (gitignored) carries DATABASE_URL into bin/setup re-runs and into
  # every bin/dev process (foreman loads it; config/boot.rb loads it too).
  if File.exist?(ENV_FILE)
    File.readlines(ENV_FILE).each do |line|
      key, value = line.strip.split("=", 2)
      ENV[key] ||= value if key && value
    end
  elsif (url = discover_postgres_url)
    # TEST_DATABASE_URL keeps `bin/rails test` off the development database.
    test_url = with_db(url, "flow_test")
    File.write(ENV_FILE, "DATABASE_URL=#{url}\nTEST_DATABASE_URL=#{test_url}\n")
    ENV["DATABASE_URL"] ||= url
    ENV["TEST_DATABASE_URL"] ||= test_url
    puts "== PostgreSQL: #{url} (written to .env) =="
  else
    puts "== No PostgreSQL server reachable — using the SQLite default =="
  end

  puts "\n== Installing dependencies =="
  system!("bundle config set --local with postgres") if ENV["DATABASE_URL"].to_s.start_with?("postgres")
  system("bundle check") || system!("bundle install")
  system!("npm --prefix frontend ci --no-audit --no-fund")

  puts "\n== Preparing database =="
  system! ARGV.include?("--reset") ? "bin/rails db:reset" : "bin/rails db:prepare"
  system! "bin/rails flow:ensure_queue_tables"
  system! "bin/rails db:seed"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts <<~DONE

    == Ready ==
    bin/dev      # Rails API (3111) + Solid Queue jobs + Vite; open http://localhost:5173
    Sign in with admin@flow.local / flowdev123 (seeded, development only).
  DONE
end
